name = "ase-dosar-admin-api"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

# Copy to wrangler.toml and edit these non-secret variables.
# For production, use a custom domain on the same registrable domain as the site.
[vars]
SITE_ORIGIN = "https://dovezi.example.ro"
GITHUB_REPO = "OWNER/REPOSITORY"
GITHUB_BRANCH = "main"
CF_ACCESS_ISSUER = "https://YOUR-TEAM.cloudflareaccess.com"
CF_ACCESS_AUD = "COPY-AUDIENCE-TAG-FROM-CLOUDFLARE-ACCESS"
ADMIN_EMAILS = "you@example.ro"

# Never enter GITHUB_TOKEN here. Set with: npx wrangler secret put GITHUB_TOKEN
