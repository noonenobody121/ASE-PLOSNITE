name = "ase-dosar-admin-api"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

# Copy to wrangler.toml and edit these non-secret variables.
# Originea paginii de admin, fără cale. Trebuie să fie identică cu originea din browser.
[vars]
SITE_ORIGIN = "https://OWNER.github.io"
GITHUB_REPO = "OWNER/REPOSITORY"
GITHUB_BRANCH = "main"

# Creează-l cu: npx wrangler kv namespace create LIMITE  și pune id-ul aici.
[[kv_namespaces]]
binding = "LIMITE"
id = "REPLACE-WITH-KV-NAMESPACE-ID"

# Never enter secrets here. Set with:
#   npx wrangler secret put PAROLA
#   npx wrangler secret put GITHUB_TOKEN
